# Copy to .env (ignored by git) and fill in. eoncloak reads ./.env from the directory
# you run it in; variables already set in your shell take precedence.

# OpenRouter (default provider): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Key for any other OpenAI-compatible server that needs one (vLLM --api-key, gateways, ...)
# EONCLOAK_API_KEY=

# Optional defaults, same as the [llm]/[anonymize] settings in eoncloak.toml
# EONCLOAK_PROVIDER=openrouter
# EONCLOAK_MODEL=anthropic/claude-haiku-5.5
# EONCLOAK_BASE_URL=http://dgx.lan:8000/v1
# EONCLOAK_LOCAL_ONLY=false
# EONCLOAK_LANGUAGE=auto
